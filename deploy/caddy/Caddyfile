{
    admin 127.0.0.1:2021
    auto_https disable_redirects
}

https://{$CLARK_GUI_HOST} {
    tls internal
    root * "{$CLARK_GUI_ROOT}/dist"
    encode zstd gzip

    @default_library path /data/default/*
    handle @default_library {
        file_server
    }

    @user_guide path /user-guide/*
    handle @user_guide {
        file_server
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}
