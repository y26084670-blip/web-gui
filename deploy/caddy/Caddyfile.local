{
    admin 127.0.0.1:2022
    auto_https disable_redirects
}

https://localhost:8443 {
    bind 127.0.0.1
    tls internal
    root * "{$CLARK_GUI_ROOT}/dist"
    encode zstd gzip

    handle /agent/rpc {
        rewrite * /rpc
        reverse_proxy 127.0.0.1:8765 {
            header_up Host 127.0.0.1:8765
        }
    }
    handle /agent/* {
        respond "Agent route not found" 404
    }
    handle /data/default/* {
        file_server
    }
    handle {
        try_files {path} /index.html
        file_server
    }
}
