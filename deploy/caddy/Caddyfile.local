{
    admin 127.0.0.1:2022
    auto_https disable_redirects
}

https://localhost:8443 {
    bind 127.0.0.1
    tls internal
    root * "{$CLARK_GUI_ROOT}/dist"
    encode zstd gzip

    handle /data/default/* {
        file_server
    }
    handle {
        try_files {path} /index.html
        file_server
    }
}
